# Copy this file to .env and fill in real values before running.

# The single shared password everyone types in to use the tool.
SHARED_PASSWORD=changeme

# Separate password only you use to toggle the "Made by Lockwood IT Services" credit on/off.
# Can be the same as SHARED_PASSWORD if you don't care about separating them.
ADMIN_PASSWORD=changeme-admin

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Port the server listens on (your Cloudflare tunnel / reverse proxy points here)
PORT=3000

# Pexels powers the built-in product photo search. Keep this server-side so it
# is never displayed or stored in users' browsers. Get a key at pexels.com/api.
PEXELS_API_KEY=

# Optional update feed. The packaged build checks this JSON file and shows an
# update banner when a newer installer is published.
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/jaredl2013/cashsaver/main/release/update.json

# ---------------------------------------------------------------------------
# Kill switch (optional) — leave both blank to disable licensing entirely and
# the app just always runs. Fill both in to let you remotely turn this
# specific install on/off from your license server (see license-server/).
# ---------------------------------------------------------------------------
LICENSE_SERVER_URL=
LICENSE_KEY=
# How many hours the app keeps working if it can't reach the license server
# (bad internet, license server down, etc) before it locks itself out as a
# safety measure. Default is 7 days.
LICENSE_GRACE_HOURS=168

# ---------------------------------------------------------------------------
# Email reminder when a scheduled ad goes live (optional) — leave blank to
# skip this entirely, nothing breaks if it's not configured.
# Works with Gmail, Outlook, or any SMTP provider. For Gmail, use an "App
# Password" (not your normal password) — Google requires it for this.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated list of who gets the "your ad is live" email
REMINDER_TO=

# ---------------------------------------------------------------------------
# Text/email the flyer to your subscriber list automatically when it goes live
# (optional) — uses the SMTP settings above for email, and Twilio for SMS/MMS.
# Leave the Twilio settings blank to skip SMS entirely; email-only works fine.
# ---------------------------------------------------------------------------

# Twilio (https://twilio.com) — SMS costs money per message plus a monthly
# number rental, there's no free tier for real sending. Get these three values
# from your Twilio console after buying a phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Only needed if you want the picture included in texts (MMS). Twilio has to
# fetch the image from a public URL, so this only works if the app is reachable
# from the internet (e.g. through a Cloudflare tunnel) — leave blank if this is
# running LAN-only on someone's office computer; texts still send, just without
# the picture attached.
PUBLIC_BASE_URL=
